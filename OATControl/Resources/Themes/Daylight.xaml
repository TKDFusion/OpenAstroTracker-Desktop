<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colors ===== -->

    <!-- Foreground / text -->
    <Color x:Key="AppForegroundColor">#FF1A1A1A</Color>
    <Color x:Key="AppForegroundStrongColor">#FF000000</Color>
	<Color x:Key="AppForegroundAccentColor">#FF3A3A3A</Color>

    <!-- Backgrounds -->
    <Color x:Key="AppWindowBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="AppNestedBackgroundColor">#FFE0E0E0</Color>
    <Color x:Key="AppInputBackgroundColor">#FFF0F0F0</Color>

    <!-- Title bar -->
    <Color x:Key="AppTitleBarBackgroundColor">#DDD</Color>
    <Color x:Key="AppTitleBarForegroundColor">#FF333333</Color>
    <Color x:Key="AppTitleBarButtonHoverColor">#FFD0D0D0</Color>
    <Color x:Key="AppTitleBarButtonPressedColor">#FFB0B0B0</Color>

    <!-- Borders -->
    <Color x:Key="AppBorderColor">#C0C0C0</Color>
    <Color x:Key="AppNestedBorderColor">#a0a0a0</Color>
    <Color x:Key="AppBorderSubtleColor">#999</Color>

    <!-- Button interactive states -->
    <Color x:Key="AppButtonBackgroundColor">#FFD0D0D0</Color>
    <Color x:Key="AppButtonBorderColor">#FFCCCCCC</Color>
    <Color x:Key="AppButtonPressedColor">#FFB0B0B0</Color>
    <Color x:Key="AppButtonHoverColor">#FFC0C0C0</Color>

    <!-- Disabled -->
    <Color x:Key="AppDisabledBackgroundColor">#FFD0D0D0</Color>
    <Color x:Key="AppDisabledBorderColor">#FFE0E0E0</Color>
    <Color x:Key="AppDisabledForegroundColor">#FF999999</Color>

	<!-- Tooltip -->
	<Color x:Key="AppTooltipBackgroundColor">#FFD0D0D0</Color>
	<Color x:Key="AppTooltipHeaderColor">#FFE0E0E0</Color>
	<Color x:Key="AppTooltipForegroundColor">#FF555555</Color>

	<!-- Toggle switch -->
    <Color x:Key="AppToggleOffColor">#FFCCCCCC</Color>
    <Color x:Key="AppToggleThumbColor">#FFFFFFFF</Color>
    <Color x:Key="AppToggleOnColor">#FFb0b0b0</Color>
    <Color x:Key="AppToggleBorderColor">#FFCCCCCC</Color>

</ResourceDictionary>
