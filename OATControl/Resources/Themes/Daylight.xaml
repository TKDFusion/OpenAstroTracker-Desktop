<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colors ===== -->

    <!-- Primary accent -->
    <Color x:Key="AppPrimaryColor">#FF0050C8</Color>

    <!-- Foreground / text -->
    <Color x:Key="AppForegroundColor">#FF1A1A1A</Color>
    <Color x:Key="AppForegroundStrongColor">#FF000000</Color>
    <Color x:Key="AppForegroundSubtleColor">#FF666666</Color>

    <!-- Backgrounds -->
    <Color x:Key="AppInputBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="AppWindowBackgroundColor">#FFF5F5F5</Color>

    <!-- Borders -->
    <Color x:Key="AppBorderColor">#FFCCCCCC</Color>
    <Color x:Key="AppBorderSubtleColor">#FFE0E0E0</Color>

    <!-- Button interactive states -->
    <Color x:Key="AppButtonBackgroundColor">#FFD0D0D0</Color>
    <Color x:Key="AppButtonHoverColor">#FFC0C0C0</Color>
    <Color x:Key="AppButtonPressedColor">#FFB0B0B0</Color>
    <Color x:Key="AppButtonBorderColor">#FFCCCCCC</Color>

    <!-- Tooltip -->
    <Color x:Key="AppTooltipBackgroundColor">#FF333333</Color>
    <Color x:Key="AppTooltipForegroundColor">#FFFFFFFF</Color>

    <!-- Disabled -->
    <Color x:Key="AppDisabledBackgroundColor">#FFD0D0D0</Color>
    <Color x:Key="AppDisabledBorderColor">#FFE0E0E0</Color>
    <Color x:Key="AppDisabledForegroundColor">#FF999999</Color>

    <!-- Title bar -->
    <Color x:Key="AppTitleBarBackgroundColor">#FFEEEEEE</Color>
    <Color x:Key="AppTitleBarForegroundColor">#FF333333</Color>
    <Color x:Key="AppTitleBarButtonHoverColor">#FFD0D0D0</Color>
    <Color x:Key="AppTitleBarButtonPressedColor">#FFB0B0B0</Color>

    <!-- Toggle switch -->
    <Color x:Key="AppToggleOnColor">#FF0050C8</Color>
    <Color x:Key="AppToggleOffColor">#FFCCCCCC</Color>
    <Color x:Key="AppToggleThumbColor">#FFFFFFFF</Color>
    <Color x:Key="AppToggleOffBorderColor">#FFCCCCCC</Color>

    <!-- ===== Brushes ===== -->

    <!-- Primary accent -->
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="{StaticResource AppPrimaryColor}" />

    <!-- Foreground / text -->
    <SolidColorBrush x:Key="AppForegroundBrush" Color="{StaticResource AppForegroundColor}" />
    <SolidColorBrush x:Key="AppForegroundStrongBrush" Color="{StaticResource AppForegroundStrongColor}" />
    <SolidColorBrush x:Key="AppForegroundSubtleBrush" Color="{StaticResource AppForegroundSubtleColor}" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{StaticResource AppWindowBackgroundColor}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="{StaticResource AppBorderSubtleColor}" />

    <!-- Button interactive states -->
    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="{StaticResource AppButtonBackgroundColor}" />
    <SolidColorBrush x:Key="AppButtonHoverBrush" Color="{StaticResource AppButtonHoverColor}" />
    <SolidColorBrush x:Key="AppButtonPressedBrush" Color="{StaticResource AppButtonPressedColor}" />
    <SolidColorBrush x:Key="AppButtonBorderBrush" Color="{StaticResource AppButtonBorderColor}" />

    <!-- Tooltip -->
    <SolidColorBrush x:Key="AppTooltipBackgroundBrush" Color="{StaticResource AppTooltipBackgroundColor}" />
    <SolidColorBrush x:Key="AppTooltipForegroundBrush" Color="{StaticResource AppTooltipForegroundColor}" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="AppDisabledBackgroundBrush" Color="{StaticResource AppDisabledBackgroundColor}" />
	<SolidColorBrush x:Key="AppDisabledBorderBrush" Color="{StaticResource AppDisabledBorderColor}" />
    <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="{StaticResource AppDisabledForegroundColor}" />

    <!-- Title bar -->
    <SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="{StaticResource AppTitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="AppTitleBarForegroundBrush" Color="{StaticResource AppTitleBarForegroundColor}" />
    <SolidColorBrush x:Key="AppTitleBarButtonHoverBrush" Color="{StaticResource AppTitleBarButtonHoverColor}" />
    <SolidColorBrush x:Key="AppTitleBarButtonPressedBrush" Color="{StaticResource AppTitleBarButtonPressedColor}" />

    <!-- Toggle switch -->
    <SolidColorBrush x:Key="AppToggleOnBrush" Color="{StaticResource AppToggleOnColor}" />
    <SolidColorBrush x:Key="AppToggleOffBrush" Color="{StaticResource AppToggleOffColor}" />
    <SolidColorBrush x:Key="AppToggleThumbBrush" Color="{StaticResource AppToggleThumbColor}" />
    <SolidColorBrush x:Key="AppToggleOffBorderBrush" Color="{StaticResource AppToggleOffBorderColor}" />

</ResourceDictionary>
