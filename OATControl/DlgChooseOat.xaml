<controls:ThemedWindow x:Class="OATControl.DlgChooseOat"
		Background="{DynamicResource AppWindowBackgroundBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OATControl.Controls"
		xmlns:local="clr-namespace:OATControl" xmlns:converters="clr-namespace:OATControl.Converters"
   		controls:ThemedWindow.TitleBarButtons="Close"
		mc:Ignorable="d"
        Title="Connect to OpenAstroTracker" Height="600" Width="500" ResizeMode="NoResize" WindowStyle="ToolWindow" >
	<controls:ThemedWindow.Resources>
		<converters:BoolToVisibilityConverter x:Key="ShowOnTrue"  Collapse="True" />
		<converters:BoolToVisibilityConverter x:Key="CollapseOnFalse"  Collapse="True" />
		<Style x:Key="ListItemsStyle" TargetType="ListViewItem">
			<Setter Property="Margin" Value="10,3,5,1" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
			<Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{TemplateBinding Padding}"
								CornerRadius="2"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppButtonHoverBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppButtonHoverBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsSelected" Value="True" />
									<Condition Property="Selector.IsSelectionActive" Value="False" />
								</MultiTrigger.Conditions>
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppButtonHoverBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
<ItemsPanelTemplate x:Key="ListBoxItemsPanel">
			<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource AppWindowBackgroundBrush}"/>
		</ItemsPanelTemplate>
	</controls:ThemedWindow.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto" MinHeight="20"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0" Grid.Column="0"  Text="Available Connections" Margin="16,16,16,18" Foreground="{DynamicResource AppForegroundBrush}" />
		<Button Grid.Row="0" Grid.Column="1"  Content="Rescan" Margin="0,10,10,12" Width="80" Style="{StaticResource MainButtonStyle}" HorizontalAlignment="Right" Command="{Binding RescanCommand}"  />
		<ListView Grid.Row="1"
				 Grid.Column="0" 
				 Grid.ColumnSpan="2" 
				 VerticalAlignment="Top"
				 ItemsSource="{Binding AvailableDevices,Mode=OneWay}" 
				 ItemsPanel="{StaticResource ListBoxItemsPanel}" 
				 SelectedItem="{Binding SelectedDevice}"
				 BorderThickness="0" 
				 ItemContainerStyle="{StaticResource ListItemsStyle}" 
				 MinHeight="18" 
				 HorizontalAlignment="Stretch" 
				 HorizontalContentAlignment="Stretch" 
				 Background="Transparent" 
				 MouseDoubleClick="Device_MouseDoubleClick"
				 Margin="20,-10,0,0">
			<ListView.ItemTemplate>
				<DataTemplate>
					<Grid HorizontalAlignment="Stretch" >
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="{Binding Path=DeviceName}" Style="{StaticResource MetroTextBlock}"/>
						<Button Grid.Column="1" Content="Setup" 
								Padding="0,-4,0,0" 
								Margin="30,0,0,0" 
								Width="80" 
								Height="20" 
								Style="{StaticResource MainButtonStyle}" 
								HorizontalAlignment="Right" 
								Command="{Binding RunSetupCommand}" 
								CommandParameter="{Binding}" 
								Visibility="{Binding SupportsSetup, Converter={StaticResource CollapseOnFalse}}" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<TextBlock Grid.Row="3" Grid.Column="0" Text="Pitch Level:" HorizontalAlignment="Right" Margin="0,19,8,12" Foreground="{DynamicResource AppForegroundStrongBrush}" Visibility="{Binding ShowLevelDisplay, Converter={StaticResource CollapseOnFalse}}" />
		<local:LevelDisplay Grid.Row="3" Grid.Column="1" Value="{Binding PitchOffset}" Range="3" Labels="-3|-2|-1|0|1|2|3" Margin="10,23,20,7" Visibility="{Binding ShowLevelDisplay, Converter={StaticResource CollapseOnFalse}}" />

		<TextBlock Grid.Row="3" Grid.Column="0" Text="Roll Level:" HorizontalAlignment="Right" Margin="0,54,8,12" Foreground="{DynamicResource AppForegroundStrongBrush}" Visibility="{Binding ShowLevelDisplay, Converter={StaticResource CollapseOnFalse}}" Grid.RowSpan="2" />
		<local:LevelDisplay Grid.Row="4" Grid.Column="1" Value="{Binding RollOffset}" Range="3" Labels="-3|-2|-1|0|1|2|3" Margin="10,3,20,7" Visibility="{Binding ShowLevelDisplay, Converter={StaticResource CollapseOnFalse}}" />

		<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding GPSStatus}" HorizontalAlignment="Center" Margin="20,9,20,20" Foreground="{DynamicResource AppForegroundStrongBrush}" Visibility="{Binding ShowGPSStatus, Converter={StaticResource ShowOnTrue}}"/>

		<TextBlock Grid.Row="6" Grid.Column="0" Text="Latitude" HorizontalAlignment="Right" Margin="0,5,7,10" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}" />
		<TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Latitude, StringFormat={}{0:0.00}}" Width="150" Margin="5,0,0,5" HorizontalAlignment="Left" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}" />

		<TextBlock Grid.Row="7" Grid.Column="0" Text="Longitude" HorizontalAlignment="Right" Margin="0,10,10,10" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}" />
		<TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Longitude, StringFormat={}{0:0.00}}" Width="150" Margin="5,5,0,5" HorizontalAlignment="Left" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}"  />

		<TextBlock Grid.Row="8" Grid.Column="0" Text="Altitude" HorizontalAlignment="Right" Margin="0,10,7,10" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}" />
		<TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Altitude}" Width="150" Margin="5,5,0,5" HorizontalAlignment="Left" Visibility="{Binding ShowManualLocation, Converter={StaticResource CollapseOnFalse}}" />

		<Grid Grid.Row="9" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<controls:ToggleSwitch Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" IsChecked="{Binding RunRAAutoHoming}" Visibility="{Binding ShowRAHoming, Converter={StaticResource CollapseOnFalse}}" />
			<TextBlock Grid.Row="0" Grid.Column="2" Text="Run RA Auto-Home" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource AppForegroundStrongBrush}" Visibility="{Binding ShowRAHoming, Converter={StaticResource CollapseOnFalse}}" />

			<controls:ToggleSwitch Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsChecked="{Binding RunDECOffsetHoming}" Visibility="{Binding ShowDECHoming, Converter={StaticResource CollapseOnFalse}}" />
			<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DECHomingMethod}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource AppForegroundStrongBrush}" Visibility="{Binding ShowDECHoming, Converter={StaticResource CollapseOnFalse}}" />
		</Grid>
		<Grid Grid.Row="11" HorizontalAlignment="Stretch" Grid.ColumnSpan="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Button Grid.Column="2" Content="Next" Command="{Binding ConnectAndNextCommand}" Margin="10" Width="80" Style="{StaticResource MainButtonStyle}" IsDefault="True" HorizontalAlignment="Right" Visibility="{Binding ShowNextButton, Converter={StaticResource CollapseOnFalse}}"/>
			<Button Grid.Column="3" Content="Cancel"  Margin="10" Width="80" Style="{StaticResource MainButtonStyle}" IsCancel="True" HorizontalAlignment="Right"/>
		</Grid>
	</Grid>
</controls:ThemedWindow>
